# .gitignore for PKI directory
# All certificates and keys are auto-generated by init-system.sh
# DO NOT commit sensitive key material

# Certificate and key files
*.key
*.crt
*.csr
*.ext
*.pem
*.p12
*.pfx
ca.srl
*.srl

# Generated files
inventory.yaml
revoked.yaml

# But keep these files visible
!.gitkeep
!README.md
!.gitignore
!revoked.yaml
