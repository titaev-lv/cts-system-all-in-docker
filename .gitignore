# Volumes - игнорировать СОДЕРЖИМОЕ data директорий, но не сами директории
volumes/mysql-data/*
volumes/mysql-dump/*
volumes/hsm-tokens/*

# Разрешить .gitkeep в директориях volumes
!volumes/.gitkeep
!volumes/mysql-data/.gitkeep
!volumes/mysql-dump/.gitkeep
!volumes/hsm-tokens/.gitkeep

# Разрешить init.sql для загрузки базы данных
!volumes/mysql-dump/init.sql

# PKI директория видима (со своим .gitignore для ключей)
# Но сами сертификаты/ключи игнорируются через volumes/pki/.gitignore

# Environment
.env
!.env.example

# Логи
*.log

# Сервисы - игнорировать проекты с кодом (у них свой git)
services/cts-core/
services/hsm-service/
services/trader-daemon/
services/web-ui-go/

# MySQL конфиги - разрешить (нет своего git)
!services/mysql/

# Но игнорировать ключи и сертификаты в mysql/pki
services/mysql/pki/**/*.key
services/mysql/pki/**/*.crt
services/mysql/pki/**/*.pem
services/mysql/pki/**/*.csr