# CT-System Environment Configuration
# Copy this file to .env and configure for your environment

# ============================================================================
# GitHub Repositories (for init-system.sh)
# ============================================================================
# Configure these URLs to enable automatic cloning of service repositories
# Leave empty if services are already cloned or will be cloned manually

CTS_CORE_REPO_URL=https://github.com/titaev-lv/cts-core.git
HSM_SERVICE_REPO_URL=https://github.com/titaev-lv/hsm-service.git
TRADER_REPO_URL=https://github.com/titaev-lv/trader.git
WEB_UI_GO_REPO_URL=https://github.com/titaev-lv/cts-web-ui-go.git

# ============================================================================
# MySQL Configuration
# ============================================================================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ct_system

# ============================================================================
# Timezone
# ============================================================================
TZ=UTC

# ============================================================================
# Container UID/GID (unified for all services)
# ============================================================================
# All service containers in docker-compose run with CT_UID/CT_GID.
# Keep these equal to owner of mounted project files (default 1001:1001).
CT_UID=1001
CT_GID=1001

# ============================================================================
# Docker Compose Configuration
# ============================================================================
# Uncomment to override default settings

# COMPOSE_PROJECT_NAME=ct-system
# COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=proxy
