# CT-System Environment Configuration
# Copy this file to .env and configure for your environment

# ============================================================================
# GitHub Repositories (for init-system.sh)
# ============================================================================
# Configure these URLs to enable automatic cloning of service repositories
# Leave empty if services are already cloned or will be cloned manually

# CTS_CORE_REPO_URL=https://github.com/your-org/cts-core.git
# HSM_SERVICE_REPO_URL=https://github.com/your-org/hsm-service.git
# TRADER_DAEMON_REPO_URL=https://github.com/your-org/trader-daemon.git
# WEB_UI_GO_REPO_URL=https://github.com/your-org/web-ui-go.git

# ============================================================================
# MySQL Configuration
# ============================================================================
MYSQL_ROOT_PASSWORD=root_dev_password_change_in_production
MYSQL_DATABASE=ct_system
MYSQL_USER=ct_user
MYSQL_PASSWORD=ct_password_change_in_production

# ============================================================================
# Timezone
# ============================================================================
TZ=UTC

# ============================================================================
# Docker Compose Configuration
# ============================================================================
# Uncomment to override default settings

# COMPOSE_PROJECT_NAME=ct-system
# COMPOSE_FILE=docker-compose.yml
